# Copy to .env and adjust. Every setting has a safe default for local development.

DISTRIBOOK_ENV=development
DISTRIBOOK_DATABASE_URL=postgresql+asyncpg://distribook:distribook@127.0.0.1:5432/distribook

# Connection pool. Budget: replicas x pool_size must stay below PostgreSQL max_connections.
DISTRIBOOK_DB_POOL_SIZE=10
DISTRIBOOK_DB_POOL_TIMEOUT_S=2.0
DISTRIBOOK_DB_CONNECT_TIMEOUT_S=5.0

# Per-session PostgreSQL limits. lock_timeout must be smaller than statement_timeout.
DISTRIBOOK_DB_STATEMENT_TIMEOUT_MS=2000
DISTRIBOOK_DB_LOCK_TIMEOUT_MS=1000
DISTRIBOOK_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000

# Concurrency-control strategy for booking.
DISTRIBOOK_BOOKING_STRATEGY=conditional

DISTRIBOOK_IDEMPOTENCY_TTL_S=86400
DISTRIBOOK_TXN_MAX_ATTEMPTS=3
